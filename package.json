{
  "name": "pepperedapron",
  "private": true,
  "version": "2.0.0",
  "description": "PepperedApron — recettes, planning de repas et listes de courses (iOS, iPadOS, Android).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "test:core": "pnpm --filter @pepperedapron/core test",
    "test:api": "pnpm --filter @pepperedapron/api test",
    "test:client": "pnpm --filter @pepperedapron/client test",
    "test:mobile": "pnpm --filter @pepperedapron/mobile test",
    "db:local": "bash scripts/local-postgres.sh",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
