{
  "name": "pepperedapron",
  "private": true,
  "version": "2.0.0",
  "description": "PepperedApron — recettes, planning de repas et listes de courses (iPhone et iPad). Sans compte ni serveur : données sur l'appareil et dans iCloud.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:core": "pnpm --filter @pepperedapron/core test",
    "test:client": "pnpm --filter @pepperedapron/client test",
    "test:mobile": "pnpm --filter @pepperedapron/mobile test",
    "test:site": "pnpm --filter @pepperedapron/site test",
    "build:site": "pnpm --filter @pepperedapron/site build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "qa:stress": "bash tools/qa/stress.sh",
    "qa:native": "node tools/qa/native-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
