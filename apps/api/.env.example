# ---- PepperedApron API — copy to .env (never commit real secrets) ----
NODE_ENV=development            # development | test | staging | production
PORT=3000
DATABASE_URL=postgres://postgres@127.0.0.1:54329/pepperedapron
DATABASE_POOL_MAX=10
# 32+ random characters: `openssl rand -base64 48`
JWT_SECRET=change-me-change-me-change-me-change-me
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:3000
TRUST_PROXY=false
RUN_MIGRATIONS_ON_START=false

# Storage: local (dev only) or s3 (Cloudflare R2, AWS S3, Scaleway…)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=

# E-mail: console (dev) | resend
MAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=PepperedApron <hello@pepperedapron.app>

# Push: none | expo
PUSH_DRIVER=none
EXPO_ACCESS_TOKEN=

# OAuth audiences (comma separated)
APPLE_AUDIENCES=app.pepperedapron
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Universal links / store links
APPLE_TEAM_ID=
IOS_BUNDLE_ID=app.pepperedapron
ANDROID_PACKAGE=app.pepperedapron
ANDROID_SHA256_CERT_FINGERPRINTS=
APP_STORE_URL=https://apps.apple.com/app/pepperedapron
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.pepperedapron

# Remote config
ADS_CONFIG={"enabled":true,"homeNativeAfterSection":3,"searchNativeEvery":8,"interstitialMinMinutes":0}
MIN_APP_VERSION=2.0.0
RATE_LIMIT_ENABLED=true
ADMIN_EMAILS=

# Legal notice (required in production)
LEGAL_PUBLISHER=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_HOSTING=

SENTRY_DSN=
