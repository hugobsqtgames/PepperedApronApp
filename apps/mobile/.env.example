# ---- PepperedApron mobile — copy to .env (read by Expo at build time) ----
# EXPO_PUBLIC_* values are embedded in the app bundle: never put secrets here.
# There is no server: the app works with no other configuration.

# development | staging | production (selects bundle id, app name and iCloud container)
APP_VARIANT=development
APPLE_TEAM_ID=
EAS_PROJECT_ID=

# Public website (privacy policy, terms, help) and support address shown in the app
SITE_URL=https://pepperedapron.app
SUPPORT_EMAIL=support@pepperedapron.app

