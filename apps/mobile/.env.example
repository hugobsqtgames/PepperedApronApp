# ---- PepperedApron mobile — copy to .env (read by Expo at build time) ----
# EXPO_PUBLIC_* values are embedded in the app bundle: never put secrets here.

# development | staging | production (selects bundle id, app name and domain)
APP_VARIANT=development
# API base URL. On a physical device use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Domain serving share links and universal links (defaults per variant)
WEB_DOMAIN=
APPLE_TEAM_ID=
EAS_PROJECT_ID=

# Sign in with Google (OAuth client ids from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Facebook Login (app id from Meta for Developers)
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Google AdMob. Outside production, Google's test ids are used automatically.
# Production builds refuse to build without the app ids.
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER=

# Crash reporting (optional)
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
